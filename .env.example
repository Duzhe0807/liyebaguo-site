# Runtime
NODE_ENV=development
PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://liyebaguo:change-me@127.0.0.1:5432/liyebaguo?schema=public
REDIS_URL=
ORDER_PAYMENT_TIMEOUT_MINUTES=15
MOCK_PAYMENT_ENABLED=true
TRUSTED_PROXY=false

# Admin bootstrap. Generate unique values outside Git and rotate after first login.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_TOTP_SECRET=
SESSION_SECRET=
TICKET_SIGNING_SECRET=

# Optional email delivery. Paid orders remain paid if email delivery is unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Formal providers remain disabled until sandbox review and merchant approval.
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_CERT_SERIAL=

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Seed published shows only when explicitly requested.
SEED_SHOWS_FROM=
SEED_SHOWS_DAYS=0